# ==========================================
# Internship Approval Backend Environment Variables
# Path: internship-approval/backend/src/main/resources/application.yml
# ==========================================

# Database Configuration
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<your-local-mysql-password>

# JWT Authentication Secret Key (REQUIRED - App will fail to start if omitted)
# Generate a secret using: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# CDPC Admin Seeding Credentials (Optional)
# If left blank or unset, AdminBootstrapRunner skips initial admin account creation if no admin exists.
BOOTSTRAP_ADMIN_EMAIL=admin@rknec.edu
BOOTSTRAP_ADMIN_PASSWORD=<set-admin-password-if-seeding>
BOOTSTRAP_ADMIN_NAME=System CDPC Admin
BOOTSTRAP_ADMIN_COLLEGE_ID=ADMIN001
