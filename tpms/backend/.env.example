# ==========================================
# TPMS Backend Environment Variables
# Path: tpms/backend/src/main/resources/application.yml
# ==========================================

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/tpms_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=<your-local-mysql-password>

# JWT Authentication Secret Key (REQUIRED - App will fail to start if omitted)
# Generate a 256-bit secret using: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_EXPIRATION_MS=86400000
ALLOWED_EMAIL_DOMAIN=rknec.edu

# Coordinator Initial Seeding Credentials
BOOTSTRAP_COORDINATOR_EMAIL=coord_user@rknec.edu
BOOTSTRAP_COORDINATOR_PASSWORD=<set-coordinator-password-if-seeding>

# Groq AI Service API Key (Optional)
# If left blank, system automatically operates in mock mode using simulated LLM extraction.
GROQ_API_KEY=<your-groq-api-key>
GROQ_MOCK_MODE=false
GROQ_MODEL=groq/compound-mini
